---
import BaseLayout from "../layouts/BaseLayout.astro"; import SiteHeader from "../components/SiteHeader.astro"; import SiteFooter from "../components/SiteFooter.astro"; import Photo from "../components/Photo.astro"; import { cafe } from "../data/cafe";
---
<BaseLayout title="Visit — Alder & Lane" description="Hours, location and arrival information for Alder & Lane."><SiteHeader current="visit" /><main class="visit-page"><header class="page-mast visit-mast"><p class="kicker">Come by</p><h1>Find a seat.</h1><p>{cafe.address}</p></header><section class="hours-block"><h2>Opening hours</h2><dl>{cafe.hours.map(h => <div><dt>{h[0]}</dt><dd>{h[1]}</dd></div>)}</dl><p class="benchmark-note">{cafe.note}</p></section><section class="location-field"><Photo kind="exterior" alt="Alder & Lane exterior photography placeholder" /><div class="map-placeholder" aria-label="Schematic map placeholder"><span>ALDER LANE</span><b>A&L</b><i>BRUNSWICK ST</i></div></section><section class="arrival-grid"><article><span>01</span><h2>Getting here</h2><p>Benchmark placeholder: transport and parking information requires verified client details.</p></article><article><span>02</span><h2>Accessibility</h2><p>Benchmark placeholder: step-free access, seating and bathroom information requires verified venue details.</p></article><article><span>03</span><h2>Say hello</h2><p><a href={"tel:" + cafe.phone.replace(/[^0-9+]/g,"")}>{cafe.phone}</a><br/><a href={"mailto:" + cafe.email}>{cafe.email}</a></p></article></section></main><SiteFooter /></BaseLayout>
