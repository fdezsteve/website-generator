---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Website Generator"
  description="Benchmark renderer for the Website Generator."
>
  <main class="mx-auto flex min-h-screen max-w-4xl items-center px-6 py-20">
    <section>
      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.14em]">Renderer ready</p>
      <h1 class="max-w-3xl text-5xl font-semibold tracking-tight sm:text-7xl">
        Website Generator
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8">
        Astro, TypeScript, Tailwind CSS v4 and Playwright are scaffolded. The first
        benchmark will replace this diagnostic page.
      </p>
    </section>
  </main>
</BaseLayout>
