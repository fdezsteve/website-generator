---
import BaseLayout from "../layouts/BaseLayout.astro"; import SiteHeader from "../components/SiteHeader.astro"; import SiteFooter from "../components/SiteFooter.astro"; import Photo from "../components/Photo.astro"; import { menu } from "../data/cafe";
---
<BaseLayout title="Menu — Alder & Lane" description="Breakfast, lunch, pastries and drinks at Alder & Lane."><SiteHeader current="menu" /><main class="menu-page"><header class="page-mast"><p class="kicker">On the table</p><h1>Menu</h1><p>Seasonal food, made here. Fictional benchmark menu data.</p></header><nav class="menu-jump" aria-label="Menu categories">{menu.map(c => <a href={"#" + c.id}>{c.label}</a>)}</nav>{menu.map((category, i) => <section class="menu-category" id={category.id}><header><span>{"0" + (i+1)}</span><h2>{category.label}</h2></header><div class="menu-category__items">{category.items.map(item => <div class="menu-line"><div><strong>{item[0]}</strong><span>{item[1]} {item[3] && <i>{item[3]}</i>}</span></div><span class="price">{"$" + item[2]}</span></div>)}</div>{i < 3 && <Photo kind={category.image} alt={category.label + " photography placeholder"} />}</section>)}<section class="visit-strip"><p class="kicker">Finished choosing?</p><h2>We'll set the table.</h2><a class="arrow-link" href="/visit">Plan your visit <span>↗</span></a></section></main><SiteFooter /></BaseLayout>
